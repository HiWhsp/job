<template>
  <div class="page">
    <div class="inner">
      <div class="title">产品对比</div>
      <div class="main">
        <div class="item-wrap">
          <div class="item" v-for="(item, index) in contrastList" :key="index">
            <div class="item-desc-wrap">
              <div class="close-icon-wrap" @click="delContrast(index)">
                <img src="@/assets/img/productComparison/close.png" alt=""/>
              </div>
              <div class="product-wrap">
                <div class="product-img-wrap">
                  <img :src="item.thumb" alt=""/>
                </div>
                <div class="product-desc-wrap">
                  <div class="product-name">{{ item.title }}</div>
                </div>
              </div>
              <div class="price-wrap">￥{{ (item.selected_num * item.priceSale).toFixed(2) }}</div>
              <div class="buy-wrap">
                <el-input-number v-model="item.selected_num" placeholder="string" size="mini"
                                 :min="1"></el-input-number>
                <div class="buy" @click="payContrast(item)">购买</div>
              </div>
              <div class="collect-wrap" @click="collectContrast(item, index)">
                <div class="collect-icon-wrap">
                  <img src="@/assets/img/productComparison/collect.png" alt="collect" v-if="item.ifShoucang == 0"/>
                  <img src="@/assets/img/productComparison/collect-active.png" alt="collect-active"
                       v-if="item.ifShoucang == 1"/>
                </div>
                <div class="collect-text">收藏</div>
              </div>
            </div>
            <div class="table-item-wrap" v-for="(item, index) in item.parameter_json" :key="index">
              {{ item.value }}
            </div>
          </div>
          <el-empty v-if="!contrastList.length" description="暂无数据..."></el-empty>
        </div>
        <div class="add">
          <div class="add-box">
            <div class="box-title">添加商品</div>
            <el-input placeholder="商品名称" v-model="keyword" class="input-with-btn">
              <div slot="append" class="append" @click="addContrast">添加</div>
            </el-input>
          </div>
          <div class="table-item-wrap" v-for="(item, index) in menuList" :key="index">
            <div class="item-name">{{ item.name }}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
export default {
  data() {
    return {
      keyword: "",
      numberVModel: 0,
      menuList: [], // 菜单列表
      contrastList: [], // 对比列表
    };
  },
  created() {
  },
  mounted() {
    this.contrastList = JSON.parse(localStorage.getItem("contrastList")) || [];
    this.menuList = this.contrastList[0] ? this.contrastList[0].parameter_json : [];
  },
  methods: {

    // 添加
    addContrast() {
      if (!this.keyword) {
        this.$message.error("请输入商品名称");
        return;
      }
      this.$api({
        url: "/service.php",
        method: "get",
        data: {
          action: "product_plist",
          keyword: this.keyword,
          orderType: 0,
          channelId: 0,
          pageNum: 1,
          page: 1
        },
      }).then(res => {
        if (res.code == 200) {
          if (res.data.list.length == 0) {
            this.$message.error("没有该商品");
            return;
          }
          // 获取商品详情
          this.$api({
            url: "/service.php",
            method: "get",
            data: {
              action: "product_detail",
              inventoryId: res.data.list[0].inventoryId,
              ifShowSku: 1
            }
          }).then(resonse => {
            if (resonse.code == 200) {
              // 当前对比列表为空
              if (this.contrastList.length == 0) {
                this.menuList = resonse.data.parameter_json;
                this.contrastList.push({...resonse.data, selected_num: 1});
                localStorage.setItem("contrastList", JSON.stringify(this.contrastList));
              }
              // 当前对比列表不为空
              else {
                let type = false;
                let channelT = false;
                for (let i = 0; i < this.contrastList.length; i++) {
                  // 是否同一类型
                  if (this.contrastList[i].channelId == resonse.data.channelId) {
                    channelT = true;
                    // 是否同一商品
                    if (this.contrastList[i].productId == resonse.data.productId) {
                      type = true;
                      break;
                    }
                  }
                }
                if (type) {
                  alertInfo("该商品已添加至对比");
                } else if (channelT) {
                  alertSucc('添加成功');
                  localStorage.setItem('contrastList', JSON.stringify([...this.contrastList, {
                    ...resonse.data,
                    selected_num: 1
                  }]));
                  this.contrastList.push({...resonse.data, selected_num: 1});
                } else {
                  alertInfo("请添加同类型商品");
                }
                this.keyword = ''
              }
            }
          })

        }
      })
    },

    // 购买商品
    payContrast(item) {
      this.$router.push({
        path: "/productDetail",
        query: {
          id: item.inventoryId
        }
      })
    },

    delContrast(index) {
      this.contrastList.splice(index, 1);
      if (this.contrastList.length == 0) {
        this.menuList = [];
        localStorage.removeItem("contrastList");
      } else {
        localStorage.setItem("contrastList", JSON.stringify(this.contrastList));
      }
    },
    // 收藏
    collectContrast(item, index) {
      this.$api({
        url: "/service.php",
        method: "get",
        data: {
          action: "product_operate",
          operateType: 1,
          operateSence: item.ifShoucang == 0 ? 0 : 1,
          productId: item.productId,
        },
      }).then(res => {
        if (res.code == 200) {
          item.ifShoucang = item.ifShoucang == 0 ? 1 : 0;
          if (item.ifShoucang == 1) {
            this.$message.success('收藏成功');
          } else {
            this.$message.success('取消收藏');
          }
          this.contrastList[index].ifShoucang = item.ifShoucang;
          localStorage.setItem("contrastList", JSON.stringify(this.contrastList));
        }
      })
    },
  },
};
</script>

