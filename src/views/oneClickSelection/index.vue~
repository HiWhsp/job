<template>

  <div class="page">
    <div class="header">
      <div class="header-title">
        参数检索
      </div>
      <div class="header-tab">
        <div class="tab-item" v-for="(item, index) in list_tab" :key="index" @click="selectTabClick(item)"
             :class="item.title == selectTab.title ? 'active' : ''">
          {{ item.title }}
        </div>
      </div>

      <div class="header-content">
        <div class="search-params">
          <div class="param-item" v-for="(item, key, index) in typeList" :key="index">
            <div class="param-label">{{ key }}</div>
            <el-select v-model="typeValue[index]" clearable :placeholder="`请选择${key}`">
              <el-option :label="it" :value="it" v-for="(it, i) in item" :key="i"></el-option>
            </el-select>
          </div>
        </div>
      </div>
      <div class="search-buttons">
        <el-button type="primary" @click="search" class="search-button">确定</el-button>
        <el-button @click="reset" class="reset-button">重置</el-button>
      </div>
    </div>

    <!-- 内容 -->
    <div class="content">
      <div class="search-result">
        <div class="result-title">搜索结果</div>
        <p>为您找到 {{ totalResults }} 条相关结果</p>
        <div class="tip">左右滑动可查看更多</div>

        <div class="table-container">
          <el-table :data="tableData" border style="width: 100%" :row-class-name="tableRowClassName">
            <el-table-column v-for="(item, index) in tableName" :key="index" :label="item" v-if="item != 'index'">
              <template slot-scope="scope">
                <span>{{ scope.row[item] }}</span>
              </template>
            </el-table-column>

            <el-table-column fixed="right" label="下载/购买" width="230">
              <template slot-scope="scope">
                <el-button @click="handleClick(scope.row)" type="text" size="small" style="color: #27417C !important;">
                  下载手册
                </el-button>
                <el-button type="text" size="small" style="color: #FF7B23 !important;" @click="addCard(scope.row)">
                  加入购物车
                </el-button>
                <el-button type="text" size="small" style="color: #FF7B23 !important;" @click="pay(scope.row)">
                  立即购买
                </el-button>
              </template>
            </el-table-column>
          </el-table>
        </div>

        <div class="tip">左右滑动可查看更多</div>
      </div>
    </div>
  </div>

</template>

<script>
export default {
  data() {
    return {
      selectTab: {}, // 选中的tab
      list_tab: [], // tab列表
      typeList: [], // 下拉框列表
      typeValue: [], // 选中的值
      tableName: [], // 表名
      totalResults: 0, // 总条数
      tableData: [], // 表格数据
      tableDataCopy: [], // 备份表格数据
      pagination: { // 分页
        page: 1,
        pageNum: 20
      }
    }
  },
  mounted() {
    this.setView();
  },
  methods: {
    async setView() {
      const {code, data} = await this.$api({
        url: "/service.php",
        method: "get",
        data: {
          action: "product_channel",
          parentId: 0,
        },
      });
      if (code === 200) {
        this.list_tab = data;
        this.selectTab = this.list_tab[0];
        this.getList();
      }

      this.$api({
        url: "/service.php",
        method: "get",
        data: {
          action: "banner_index",
          position: 0, //服务端：0-全部 1-通用 2-PC 3-H5 4-小程序 5-APP
        },
      }).then(res => {
        if (res.data) {
          if (res.data[6]) {
            document.getElementsByClassName('header')[0].style.backgroundImage = `url(${res.data[6].images[0].image})`;
          }
        }
      })
      this.search();
    },
    // 点击tab
    selectTabClick(tab) {
      this.selectTab = tab;
      this.getList();
    },
    // 获取下拉框列表
    getList() {
      this.$api({
        url: "/service.php",
        method: "post",
        data: {
          action: "product_parameterSelect",
          channelId: this.selectTab.id,
        },
      }).then(res => {
        if (res.code == 200) {
          this.typeList = res.data;
        }
      })
    },
    // 搜索
    search() {
      let keys = [];
      this.typeValue.forEach(item => {
        if (item) {
          keys.push(item);
        }
      });
      // 实现搜索逻辑
      this.$api("product_plist", {
        ...this.pagination,
        orderType: 0,
        channelId: this.selectTab.id,
        parameterKeys: keys.join(','),
      }).then(res => {
        if (res.code == 200) {
          this.tableDataCopy = res.data.list;
          this.tableData = res.data.list.map((item, index) => {
            if (item.parameter_json && item.parameter_json.length) {
              return item.parameter_json.reduce((obj, item) => {
                obj[item.name] = item.value;
                return {...obj, index};
              }, {});
            } else {
              return {index}
            }
          });
          for (let i = 0; i < this.tableData.length; i++) {
            if (Object.keys(this.tableData[i]).length) {
              this.tableName = Object.keys(this.tableData[i]);
              return;
            }
          }
          this.totalResults = res.data.count;
        }
      })
    },
    reset() {
      this.typeValue = [];
      this.search();
    },
    tableRowClassName({row, rowIndex}) {
      return rowIndex % 2 === 0 ? 'even-row' : 'odd-row'
    },

    handleClick(row) {

    },
    addCard(row) {

    },
    pay(row) {
      this.$router.push(`/productDetail?id=${this.tableDataCopy[row.index].inventoryId}`);
    }
  }
};

</script>


